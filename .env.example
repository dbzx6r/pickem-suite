# Run sh scripts/configure.sh to generate random local credentials.
# Keep the real .env private and chmod 600. Never commit or share it.
APP_URL=http://localhost:3000
APP_PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AUTH_SECRET=REPLACE_WITH_RANDOM_HEX
CRON_SECRET=REPLACE_WITH_RANDOM_HEX
ADMIN_EMAIL=commissioner@example.invalid
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
LEAGUE_NAME=Pickem Suite
SEASON_YEAR=
# External content is optional. Read docs/LEGAL.md before enabling.
ENABLE_ESPN_DATA=false
# Build-time flag: rebuild app after changing it.
NEXT_PUBLIC_TEAM_LOGOS_ENABLED=false
# Optional web push; generate your own keys. HTTPS required except localhost.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:commissioner@example.invalid
# Optional automation access restricted to one explicitly selected player ID.
AUTOPICK_ALLOWED_USER_ID=

# Optional native companion integration (no native app is distributed).
LIVE_ACTIVITIES_ENABLED=false
PICK_REMINDERS_ENABLED=false
APNS_BUNDLE_ID=
APNS_TEAM_ID=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_KEY_PATH=
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_KEY_PATH=
